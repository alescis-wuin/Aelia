<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>fr.alescis</groupId>
    <artifactId>aelia</artifactId>
    <version>0.4.1-SNAPSHOT</version>
    <name>Aelia</name>
    <description>Accessible JavaFX weather dashboard with a native interactive OpenStreetMap tile view.</description>
    <url>https://github.com/alescis-wuin/Aelia</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit/</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>26</maven.compiler.release>
        <javafx.version>26.0.1</javafx.version>
        <atlantafx.version>2.1.0</atlantafx.version>
        <junit.jupiter.version>5.10.2</junit.jupiter.version>

        <aelia.weather.provider>auto</aelia.weather.provider>
        <aelia.openmeteo.latitude></aelia.openmeteo.latitude>
        <aelia.openmeteo.longitude></aelia.openmeteo.longitude>
        <aelia.openmeteo.city></aelia.openmeteo.city>
        <aelia.openmeteo.country></aelia.openmeteo.country>
        <aelia.openmeteo.timezone></aelia.openmeteo.timezone>
        <aelia.openmeteo.connectTimeoutSeconds>20</aelia.openmeteo.connectTimeoutSeconds>
        <aelia.openmeteo.requestTimeoutSeconds>40</aelia.openmeteo.requestTimeoutSeconds>
        <aelia.diagnostics>true</aelia.diagnostics>
        <java.net.preferIPv4Stack>false</java.net.preferIPv4Stack>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>${atlantafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <showWarnings>true</showWarnings>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>fr.alescis.aelia/fr.alescis.aelia.AeliaApplication</mainClass>
                    <options>
                        <option>-Daelia.weather.provider=${aelia.weather.provider}</option>
                        <option>-Daelia.openmeteo.latitude=${aelia.openmeteo.latitude}</option>
                        <option>-Daelia.openmeteo.longitude=${aelia.openmeteo.longitude}</option>
                        <option>-Daelia.openmeteo.city=${aelia.openmeteo.city}</option>
                        <option>-Daelia.openmeteo.country=${aelia.openmeteo.country}</option>
                        <option>-Daelia.openmeteo.timezone=${aelia.openmeteo.timezone}</option>
                        <option>-Daelia.openmeteo.connectTimeoutSeconds=${aelia.openmeteo.connectTimeoutSeconds}</option>
                        <option>-Daelia.openmeteo.requestTimeoutSeconds=${aelia.openmeteo.requestTimeoutSeconds}</option>
                        <option>-Daelia.diagnostics=${aelia.diagnostics}</option>
                        <option>-Djava.net.preferIPv4Stack=${java.net.preferIPv4Stack}</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
